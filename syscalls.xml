<?xml version="1.0" encoding="utf-8"?>

<syscalls xmlns="urn:linux-syscalls-draft:1.0">

  <types>
    <int name="s8"  bits="8"  signed="true" />
    <int name="u8"  bits="8"  signed="false" />
    <int name="s16" bits="16" signed="true" />
    <int name="u16" bits="16" signed="false" />
    <int name="s32" bits="32" signed="true" />
    <int name="u32" bits="32" signed="false" />
    <int name="s64" bits="64" signed="true" />
    <int name="u64" bits="64" signed="false" />

    <alias name="int"     of="s32" />
    <alias name="uint"    of="u32" />
    <alias name="long"    of="s64" />
    <alias name="ulong"   of="u64" />
    <alias name="size_t"  of="u64" />
    <alias name="ssize_t" of="s64" />
    <alias name="pid_t"   of="s32" />
    <alias name="uid_t"   of="u32" />
    <alias name="gid_t"   of="u32" />
    <alias name="off_t"   of="s64" />
    <alias name="mode_t"  of="u32" />
    <alias name="fd"      of="s32" />
    <alias name="cstr"    of="char[]" />
    <alias name="char"    of="s8" />
  </types>

  <module name="proc">

    <syscall name="getpid">
      <number arch="x86_64"  value="39"/>
      <number arch="aarch64" value="172"/>
      <number arch="riscv64" value="172"/>
      <return type="pid_t" error_convention="always_succeeds"/>
    </syscall>

  </module>

  <syscall name="exit" noreturn="true">
    <number arch="x86_64" value="60" />
    <number arch="aarch64" value="93" />
    <number arch="riscv64" value="93" />
    <arg name="error_code" type="s32" direction="in" />
  </syscall>

  <module name="mm">
    <bitset name="prot" backing="u32">
      <flag name="read"      bit="0" />
      <flag name="write"     bit="1" />
      <flag name="exec"      bit="2" />
      <flag name="sem"       bit="3" />
      <reserved              bits="4-23" />
      <flag name="growsdown" bit="24" />
      <flag name="growsup"   bit="25" />
    </bitset>

    <bitset name="map" backing="u32">
      <enum name="Type" bits="0-3">
        <value name="shared" value="1" />
        <value name="private" value="2" />
        <value name="shared_validate" value="3" />
        <value name="droppable" value="8" />
      </enum>
      <flag name="fixed"           bit="4" />
      <flag name="anonymous"       bit="5" />
      <flag name="32bit"           bit="6"  arch="x86_64" />
      <flag name="above4g"         bit="7"  arch="x86_64" />
      <flag name="growsdown"       bit="8"  arch="x86_64 aarch64" />
      <flag name="denywrite"       bit="11" arch="x86_64 aarch64" />
      <flag name="executable"      bit="12" arch="x86_64 aarch64" />
      <flag name="locked"          bit="13" arch="x86_64 aarch64" />
      <flag name="noreserve"       bit="14" arch="x86_64 aarch64" />
      <flag name="populate"        bit="15" />
      <flag name="nonblock"        bit="16" />
      <flag name="stack"           bit="17" />
      <flag name="hugetlb"         bit="18" />
      <flag name="sync"            bit="19" />
      <flag name="fixed_noreplace" bit="20" />
      <reserved bits="21-25" />
      <flag name="uninitialized"   bit="26" />
      <reserved bits="27-31" />
    </bitset>

    <syscall name="mmap">
      <number arch="x86_64" value="9" />
      <number arch="aarch64" value="222" />
      <number arch="riscv64" value="222" />
      <arg name="addr" type="void[length]" nullable="true" />
      <arg name="length" type="size_t" />
      <arg name="prot" type="prot" />
      <arg name="flags" type="map" />
      <arg name="fd" type="fd" />
      <arg name="offset" type="off_t" />
      <return type="void[length]" error_convention="negative_errno_as_pointer" />
    </syscall>
  </module>

</syscalls>
